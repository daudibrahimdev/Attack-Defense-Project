<decoder name="auditd">
  <prematch>^node=\S+ type=|^type=</prematch>
</decoder>

<decoder name="auditd-child">
  <parent>auditd</parent>
  <regex type="pcre2">.*?\bladdr=([^\s]+)</regex>
  <order>srcip</order>
</decoder>

<decoder name="auditd-child">
  <parent>auditd</parent>
  <regex type="pcre2">.*?\blport=([^\s]+)</regex>
  <order>srcport</order>
</decoder>